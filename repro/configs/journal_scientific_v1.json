{
  "profile": "journal_scientific_v1",
  "purpose": "Scientifically calibrated journal setting; not an exact numerical reproduction of SIGIR 2024.",
  "datasets": ["gowalla", "brightkite"],
  "graph_sizes": [3000, 5000],
  "worker_pool_size": 300,
  "target_subareas": 100,
  "primary_random_seed": 2024,
  "replication_seeds": [2024, 2025, 2026, 2027, 2028],
  "participation": {
    "proxy": "exp(-minimum historical distance / robust distance scale)",
    "distance_scale_quantile": 0.5
  },
  "quality": {
    "proxy": "robustly normalized log historical in-region check-in count",
    "floor": 0.25,
    "lower_quantile": 0.1,
    "upper_quantile": 0.9
  },
  "demand": {
    "main_load_factor": 1.25,
    "sensitivity_load_factors": [0.75, 1.0, 1.25, 1.5],
    "activity_power": 0.5,
    "floor_ratio": 0.05,
    "calibration": "global median positive direct capacity of the candidate pool"
  },
  "influence": {
    "model": "independent_cascade",
    "probability_protocol": "trivalency",
    "values": [0.01, 0.05, 0.1],
    "sensitivity_required": true
  },
  "coverage_embedding": {
    "main": "objective-contribution",
    "base_feature": "participation * quality / demand",
    "include_direct_term": true,
    "legacy_ablation": "legacy-quality",
    "piic_range": 2
  },
  "budgets": {
    "primary": [5, 10, 20, 30, 40, 50],
    "stress_test": [75, 100]
  },
  "evaluation": {
    "independent_live_edge_worlds": true,
    "recommended_mc_worlds": 300,
    "report_saturation_fraction": true,
    "report_random_baseline_repeats": 20
  }
}
